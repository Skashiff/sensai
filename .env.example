# PostgreSQL development database. Replace with your own connection URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sensai?schema=public"

# Clerk: set your real development keys in .env.local or hosting environment settings.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Google Gemini. Change the model here when retiring/upgrading a model.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Inngest Cloud: needed for production scheduled jobs.
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""
